{
  "rewrites": [
    { "source": "/img/:path*", "destination": "https://res.cloudinary.com/deroy68n9/image/upload/:path*" },
    { "source": "/((?!img/|assets/|logo|vite.svg|programme_normal.ttf|404.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
